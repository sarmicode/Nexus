{
  "info": {
    "name": "FarmBridge — Phase 01 (Auth & Users)",
    "description": "Postman collection for the Phase 01 acceptance criteria.\n\nSetup (once):\n1. cd backend && cp .env.example .env (then set real MONGO_URI + ADMIN_PHONE/ADMIN_PASSWORD)\n2. npm run dev\n3. npm run seed:admin\n4. Set the adminPhone / adminPassword collection variables below (match backend/.env).\n\nRun top-to-bottom. The rate-limit requests at the end exhaust the auth budget (10/15 min per IP) — wait out the window before more manual logins.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "password", "value": "Passw0rd!phase1" },
    { "key": "farmerPhone", "value": "9876543211" },
    { "key": "farmerEmail", "value": "farmer@test.farmbridge.dev" },
    { "key": "buyerPhone", "value": "9876543212" },
    { "key": "adminPhone", "value": "9876543210" },
    { "key": "adminPassword", "value": "Admin@12345" },
    { "key": "farmerAccess", "value": "" },
    { "key": "farmerRefresh", "value": "" },
    { "key": "farmerRefreshOld", "value": "" },
    { "key": "buyerAccess", "value": "" },
    { "key": "adminAccess", "value": "" }
  ],
  "item": [
    {
      "name": "Register Farmer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Farmer\",\n  \"phone\": \"{{farmerPhone}}\",\n  \"email\": \"{{farmerEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"farmer\",\n  \"language\": \"en\",\n  \"location\": {\n    \"village\": \"Raipur\",\n    \"district\": \"Munger\",\n    \"state\": \"Bihar\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Envelope success + tokens', () => {",
              "  const j = pm.response.json();",
              "  pm.expect(j.success).to.be.true;",
              "  pm.expect(j.data.accessToken).to.be.a('string');",
              "  pm.expect(j.data.refreshToken).to.be.a('string');",
              "  pm.expect(j.data.user.role).to.eql('farmer');",
              "});",
              "pm.test('No password in response', () => {",
              "  pm.expect(pm.response.text()).to.not.include('passwordHash');",
              "  pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('password'));",
              "});",
              "const j = pm.response.json();",
              "pm.collectionVariables.set('farmerAccess', j.data.accessToken);",
              "pm.collectionVariables.set('farmerRefresh', j.data.refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Register Buyer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Buyer\",\n  \"phone\": \"{{buyerPhone}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"buyer\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 (buyer role)', () => {",
              "  const j = pm.response.json();",
              "  pm.response.to.have.status(201);",
              "  pm.expect(j.data.user.role).to.eql('buyer');",
              "});",
              "const j = pm.response.json();",
              "pm.collectionVariables.set('buyerAccess', j.data.accessToken);"
            ]
          }
        }
      ]
    },
