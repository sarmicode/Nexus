          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 401 (tokens wiped on logout)', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Rate limit — hammer login (expect 429)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Send 12 wrong-password logins; assert at least one 429.",
              "// NOTE: this exhausts the auth budget (10/15 min per IP) —",
              "// run it LAST and wait out the window before more logins.",
              "(async () => {",
              "  let saw429 = false;",
              "  for (let i = 0; i < 12; i++) {",
              "    const res = await pm.sendRequest({",
              "      url: pm.collectionVariables.get('baseUrl') + '/auth/login',",
              "      method: 'POST',",
              "      header: [{ key: 'Content-Type', value: 'application/json' }],",
              "      body: {",
              "        mode: 'raw',",
              "        raw: JSON.stringify({",
              "          identifier: pm.collectionVariables.get('farmerPhone'),",
              "          password: 'WrongPass' + Date.now() + i",
              "        })",
              "      }",
              "    });",
              "    if (res.code === 429) saw429 = true;",
              "  }",
              "  pm.test('Hit 429 within 12 wrong-password attempts', () => pm.expect(saw429).to.be.true);",
              "})();"
            ]
          }
        }
      ]
    }
  ]
}
