          "raw": "{{baseUrl}}/users?page=1&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["users"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "20" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 + paginated users', () => {",
              "  const j = pm.response.json();",
              "  pm.response.to.have.status(200);",
              "  pm.expect(j.data.users).to.be.an('array');",
              "  pm.expect(j.data.total).to.be.a('number');",
