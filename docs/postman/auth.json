          "raw": "{\n  \"refreshToken\": \"{{farmerRefresh}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 + new pair', () => {",
              "  const j = pm.response.json();",
