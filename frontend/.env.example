# ── FarmBridge web app — environment template ───────────────────────────
# Copy to `.env`:  cp .env.example .env
# VITE_* values are PUBLIC by definition — never put secrets here (RULES.md §5).

# Base URL of the FarmBridge API (versioned root — all routes live under /api/v1).
# Leave as /api/v1 for local dev — the Vite dev server proxies /api to
# http://localhost:5000 (see vite.config.js). For a deployed backend set the
# full versioned URL, e.g. https://api.farmbridge.example/api/v1
VITE_API_BASE_URL=/api/v1

# Maps (optional — Phase 07 uses Leaflet + OpenStreetMap, which needs no key)
VITE_MAPS_API_KEY=
