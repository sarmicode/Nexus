# FarmBridge Backend Environment Variables
# Copy to .env and fill in real values for production.

PORT=5000
NODE_ENV=development

# MongoDB — required.
MONGO_URI=mongodb://127.0.0.1:27017/farmbridge

# JWT — required. Use a strong random secret (≥ 32 chars) in production.
JWT_SECRET=dev_change_me_in_production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Admin seed (npm run seed:admin).
ADMIN_PHONE=9876543210
ADMIN_PASSWORD=Admin@1234

# Redis (optional — in-memory cache used when absent).
REDIS_URL=redis://localhost:6379

# CORS allowlist (comma-separated; enforced in production).
CORS_ORIGIN=http://localhost:5173

# Rate limiting.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Payment (Razorpay test mode).
PAYMENT_API_KEY=your_payment_key
PAYMENT_API_SECRET=your_payment_secret

# External data sources.
DATA_GOV_IN_API_KEY=
AGMARKNET_BASE_URL=

# ML service (Phase 05).
ML_SERVICE_URL=http://localhost:8000
USE_ML=false

# Email / SMS (Phase 06).
EMAIL_API_KEY=your_email_api_key
SMS_API_KEY=your_sms_api_key

# Maps (optional — Leaflet/OSM needs no key).
MAPS_API_KEY=
