# ── FarmBridge API — environment template ─────────────────────────────
# Copy to `.env` and fill in values:  cp .env.example .env
# The values below are LOCAL DEV defaults (no real secrets) so the README
# quick start works out of the box. Never commit `.env` itself.

# Server
PORT=5000
NODE_ENV=development

# Database — local MongoDB or free Atlas M0 (see docs/FREE_TIER_PLAN.md)
MONGO_URI=mongodb://127.0.0.1:27017/farmbridge

# Auth — MUST be a strong random secret (≥ 32 chars) in every real environment
JWT_SECRET=dev_change_me_in_production
# Token lifetimes (s/m/h/d): short-lived access + long-lived refresh (RULES.md §7)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Admin seed script (npm run seed:admin) — first admin for the admin UI
ADMIN_PHONE=
ADMIN_PASSWORD=

# Cache — local Redis or free Upstash (used from Phase 04)
REDIS_URL=redis://localhost:6379

# CORS — comma-separated allowlist, enforced when NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# External integrations — filled in later phases (Phase 06/07)
EMAIL_API_KEY=
SMS_API_KEY=
PAYMENT_API_KEY=
MAPS_API_KEY=
